{
    "name": "zdearo/module-manager",
    "description": "Laravel modular architecture package. Self-contained modules with routes, models, migrations, config, and Filament support.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Zdearo\\ModuleManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zdearo\\ModuleManager\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Adryel Dearo",
            "email": "adryel@zdearo.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/semver": "^3.4",
        "ext-zip": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zdearo\\ModuleManager\\ModuleManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
